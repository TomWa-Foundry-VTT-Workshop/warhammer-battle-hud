<div class="whb-hud">
  <div class="whb-side">
    <div class="whb-grip" data-tooltip="{{localize 'WHAMMO.Drag'}}" aria-label="{{localize 'WHAMMO.Drag'}}"><i class="fa-solid fa-grip-vertical" inert></i></div>
    {{#if advantage}}
      <button type="button" class="whb-advantage {{advantage.level}} {{#if advantage.changed}}changed{{/if}} {{#unless advantage.editable}}readonly{{/unless}}" data-action="gainAdvantage" data-tooltip="{{advantage.hint}}" aria-label="{{advantage.label}}: {{advantage.state}}">
        <span class="whb-advantage-label">{{advantage.label}}</span>
        {{#if advantage.toggle}}
          <strong class="whb-advantage-value whb-momentum"><i class="fa-solid {{#if advantage.active}}fa-angles-right{{else}}fa-minus{{/if}}" inert></i></strong>
          <span class="whb-advantage-max">{{advantage.state}}</span>
        {{else}}
          <strong class="whb-advantage-value">{{advantage.value}}</strong>
        {{/if}}
        {{#if advantage.max}}{{#unless advantage.toggle}}<span class="whb-advantage-max">/ {{advantage.max}}</span>{{/unless}}{{/if}}
      </button>
    {{/if}}
    {{#if hands}}
      <div class="whb-hands" aria-label="{{hands.label}}: {{hands.count}}">
        <span class="whb-hands-label">{{hands.label}} <strong>{{hands.count}}</strong></span>
        <div class="whb-hand-slots">
          {{#each hands.slots}}
            <div class="whb-hand {{role}} {{#if item}}held{{/if}} {{#if useless}}useless{{/if}} {{#if over}}over{{/if}}" data-hand="{{key}}" style="--whb-span: {{span}}">
              {{#if open}}
                <ul class="wham-list whb-hand-list">
                  {{#each options}}
                    <li><button type="button" class="{{#if current}}current{{/if}}" data-action="holdWeapon" data-weapon="{{id}}" {{#if disabled}}disabled{{/if}}>
                      <img src="{{img}}" alt=""> <span>{{name}}</span>
                      {{#if twoHanded}}<em class="whb-two-handed">2</em>{{/if}}
                      {{#if equipped}}<i class="fa-solid fa-hand" inert></i>{{/if}}
                    </button></li>
                  {{/each}}
                  {{#if item}}
                    <li><button type="button" data-action="emptyHand"><i class="fa-regular fa-hand" inert></i> <span>{{emptyLabel}}</span></button></li>
                  {{/if}}
                </ul>
              {{/if}}
              <button type="button" class="whb-hand-slot" data-action="toggleHand" data-tooltip-html="{{tooltip}}" data-tooltip-class="whb-tooltip" {{#if useless}}disabled{{/if}}>
                {{#if item}}
                  <img src="{{item.img}}" alt="{{item.name}}">
                  {{#if item.twoHanded}}<em class="whb-two-handed">2</em>{{/if}}
                {{else}}
                  <i class="{{icon}}" inert></i>
                {{/if}}
                {{#if (eq role "off")}}{{#unless item.twoHanded}}<span class="whb-hand-mark">{{localize "WHAMMO.Hands.OffShort"}}</span>{{/unless}}{{/if}}
              </button>
              {{#if attack}}
                <button type="button" class="whb-hand-attack {{attack.kind}} {{#unless attack.ready}}unready{{/unless}}" data-action="attackWith" data-value="{{attack.value}}" data-tooltip-html="{{attack.tooltip}}" data-tooltip-class="whb-tooltip" aria-label="{{attack.label}}: {{item.name}}">
                  <i class="{{attack.icon}}" inert></i>
                </button>
              {{else}}
                <span class="whb-hand-attack placeholder" aria-hidden="true"></span>
              {{/if}}
            </div>
          {{/each}}
        </div>
      </div>
    {{/if}}
  </div>
  <div class="whb-stack">
    {{#if actionPanel}}
      <div class="whb-panel{{#if actionColumns}} whb-columns" style="--whb-columns: {{actionColumns}}{{/if}}">
        {{#each actionPanel}}
          <section>
            <h4>{{label}}</h4>
            <div class="whb-actions">
              {{#each actions}}
                {{#if secondary}}<div class="whb-pair">{{/if}}
                <button type="button" class="whb-action {{cssClass}}" data-action="runAction" data-value="{{value}}" {{#if tooltip}}data-tooltip-html="{{tooltip}}" data-tooltip-class="whb-tooltip"{{/if}}>
                  {{#if img}}<img src="{{img}}" alt="">{{/if}}
                  <span>{{name}}</span>
                  {{#if detail}}<small>{{detail}}</small>{{/if}}
                </button>
                {{#if secondary}}
                  <button type="button" class="whb-action whb-secondary" data-action="runAction" data-value="{{secondary.value}}" data-tooltip-html="{{secondary.tooltip}}" data-tooltip-class="whb-tooltip" aria-label="{{secondary.label}}">
                    <i class="{{secondary.icon}}" inert></i>
                  </button>
                </div>
                {{/if}}
              {{/each}}
            </div>
          </section>
        {{/each}}
      </div>
    {{/if}}
    {{#if actionTabs.length}}
      <nav class="whb-tabs">
        {{#each actionTabs}}
          <button type="button" class="{{#if active}}active{{/if}}" data-action="openTab" data-tab="{{id}}">{{label}}</button>
        {{/each}}
      </nav>
    {{/if}}
    <div class="wham-bar">
      {{#each weapons}}
        <div class="wham-weapon {{#unless equipped}}unequipped{{/unless}}" data-weapon="{{id}}">
          {{#if open}}
            <ul class="wham-list">
              {{#each options}}
                <li><button type="button" class="{{#if current}}current{{/if}}" data-action="chooseAmmo" data-ammo="{{id}}"><img src="{{img}}" alt=""> <span>{{name}}</span> <strong>{{count}}</strong></button></li>
              {{else}}
                <li class="hint">{{localize "WHAMMO.NoAmmo"}}</li>
              {{/each}}
            </ul>
          {{/if}}
          <button type="button" class="wham-icon" data-action="toggleEquip" data-tooltip="{{name}}: {{localize 'WHAMMO.ToggleEquip'}}" aria-label="{{name}}"><img src="{{img}}" alt=""></button>
          <button type="button" class="wham-ammo {{ammo.state}}" data-action="toggleList" data-tooltip="{{localize 'WHAMMO.ChooseAmmo'}}">
            {{#if ammo}}
              <img src="{{ammo.img}}" alt=""><span class="name">{{ammo.name}}</span><strong>{{ammo.count}}</strong>
            {{else}}
              <span class="name">{{localize "WHAMMO.NoneSelected"}}</span>
            {{/if}}
          </button>
          {{#if load}}
            <button type="button" class="wham-reload {{#if load.needsReload}}needed{{/if}}" data-action="reload" data-tooltip="{{localize 'WHAMMO.Reload'}}" aria-label="{{localize 'WHAMMO.Reload'}}">
              <i class="fa-solid fa-rotate"></i>{{#if load.text}} {{load.text}}{{/if}}
            </button>
          {{/if}}
        </div>
      {{/each}}
    </div>
  </div>
</div>
