<section class="whb-customize-section">
  <h3>{{localize "WFRP4E_HUD.Customize.AdvantageActions"}}</h3>
  <p class="hint">{{localize "WFRP4E_HUD.Customize.AdvantageActionsHint"}}</p>
  {{#if rows.length}}
  <ol class="whb-customize-rows">
    {{#each rows}}
    <li class="whb-customize-row">
      <input type="hidden" name="actions.{{@index}}.id" value="{{id}}">
      <div class="whb-customize-line">
        <label class="whb-customize-name">
          <span>{{localize "WFRP4E_HUD.Customize.Name"}}</span>
          <input type="text" name="actions.{{@index}}.name" value="{{name}}" maxlength="{{@root.limits.name}}" required>
        </label>
        <label class="whb-customize-cost">
          <span>{{localize "WFRP4E_HUD.Customize.Cost"}}</span>
          <input type="number" name="actions.{{@index}}.cost" value="{{cost}}" min="0" max="{{@root.limits.cost}}" step="1" required>
        </label>
        <label class="whb-customize-macro">
          <span>{{localize "WFRP4E_HUD.Customize.Macro"}}</span>
          <select name="actions.{{@index}}.macro">
            {{#each macroOptions}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </label>
        <button type="button" class="whb-customize-delete" data-action="deleteAction" data-id="{{id}}">
          <i class="fa-solid fa-trash" inert></i> {{localize "WFRP4E_HUD.Customize.Delete"}}
        </button>
      </div>
      <label class="whb-customize-description">
        <span>{{localize "WFRP4E_HUD.Customize.Description"}}</span>
        <textarea name="actions.{{@index}}.description" maxlength="{{@root.limits.description}}" rows="2">{{description}}</textarea>
      </label>
    </li>
    {{/each}}
  </ol>
  {{else}}
  <p class="whb-customize-empty">{{localize "WFRP4E_HUD.Customize.Empty"}}</p>
  {{/if}}
  <div class="whb-customize-add">
    <button type="button" data-action="addAction" {{#if full}}disabled{{/if}}>
      <i class="fa-solid fa-plus" inert></i> {{localize "WFRP4E_HUD.Customize.Add"}}
    </button>
    <span class="hint">{{limitText}}</span>
  </div>
</section>
